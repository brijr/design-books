---
import GrammarSwatch from "./GrammarSwatch.astro";
import ImageRail from "./ImageRail.astro";
import Plate from "./Plate.astro";
import RailItem from "./RailItem.astro";
import Specimen from "./Specimen.astro";
import { railTiles, type StyleEntry } from "../lib/styles";

interface Props {
  entry: StyleEntry;
  size?: "index" | "entry";
}

const { entry, size = "index" } = Astro.props;
const tiles = railTiles(entry);
const selfHref = `/${entry.id}`;
const cover = entry.data.images[0];
const specimenLabel = cover?.alt ?? `${entry.data.title} specimen`;
---

<ImageRail label={`Visual grammar for ${entry.data.title}`}>
  {
    tiles.map((tile) => {
      switch (tile.kind) {
        case "specimen":
          return (
            <RailItem caption={tile.label}>
              <Plate href={selfHref} label={specimenLabel} size={size}>
                <Specimen id={tile.id} compact image={cover} />
              </Plate>
            </RailItem>
          );
        case "swatch":
          return (
            <RailItem caption={tile.label}>
              <Plate href={selfHref} label={`${entry.data.title} ${tile.label}`} size={size}>
                <GrammarSwatch id={tile.id} aspect={tile.aspect} />
              </Plate>
            </RailItem>
          );
        default: {
          const _exhaustive: never = tile;
          return _exhaustive;
        }
      }
    })
  }
</ImageRail>
{
  size === "entry" && cover && (
    <p class="text-xs text-zinc-400">
      {cover.alt}. {cover.source}. {cover.license}.
    </p>
  )
}
