---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import Bauhaus from "./specimens/Bauhaus.astro";
import Memphis from "./specimens/Memphis.astro";
import Minimalism from "./specimens/Minimalism.astro";
import Neubrutalism from "./specimens/Neubrutalism.astro";
import PlateById from "./specimens/PlateById.astro";
import Y2K from "./specimens/Y2K.astro";
import { hasSpecimen } from "../lib/specimens";

interface Props {
  id: string;
  compact?: boolean;
  image?: { src: ImageMetadata; alt: string };
}

const { id, compact = false, image } = Astro.props;

const custom = {
  bauhaus: Bauhaus,
  memphis: Memphis,
  minimalism: Minimalism,
  neubrutalism: Neubrutalism,
  y2k: Y2K,
} as const;

const Custom = Object.hasOwn(custom, id) ? custom[id as keyof typeof custom] : undefined;
---

<div class:list={["h-full", image && "specimen-photo", image && id === "de-stijl" && "is-destijl"]}>
  {
    image ? (
      <Image src={image.src} alt={image.alt} loading="eager" />
    ) : Custom ? (
      <Custom compact={compact} />
    ) : hasSpecimen(id) ? (
      <PlateById id={id} compact={compact} />
    ) : (
      <div class="grid h-full place-items-center text-sm text-zinc-400">
        Specimen forthcoming
      </div>
    )
  }
</div>

<style>
  .specimen-photo :global(img),
  .specimen-photo :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .specimen-photo.is-destijl :global(img) {
    object-position: left center;
  }
</style>
