---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class:list={["y2k", compact && "is-compact"]} data-specimen="live">
  <div class="stage">
    <span class="blob" aria-hidden="true"></span>
    <span class="star" aria-hidden="true">✦</span>
    <p class="wordmark">Y2K</p>
    {compact ? <span class="enter">Enter</span> : <button type="button">Enter</button>}
    {
      !compact && (
        <p class="caption">chrome · gel · specular highlight</p>
      )
    }
  </div>
</div>

<style>
  .y2k {
    height: 100%;
    color: white;
    background:
      radial-gradient(circle at 20% 20%, #5b2cff 0, transparent 40%),
      radial-gradient(circle at 80% 80%, #ff2d95 0, transparent 42%),
      linear-gradient(160deg, #07061a, #1a0b3d 55%, #041428);
  }

  .stage {
    position: relative;
    display: grid;
    height: 100%;
    min-height: inherit;
    place-items: center;
    padding: 1.5rem;
    overflow: hidden;
  }

  .blob {
    position: absolute;
    top: 12%;
    right: 14%;
    width: 5rem;
    height: 5rem;
    border-radius: 60% 40% 55% 45%;
    background: linear-gradient(145deg, #7ef0ff, #2d6bff 55%, #9a4dff);
    box-shadow:
      inset 0.4rem 0.3rem 0.6rem rgba(255, 255, 255, 0.55),
      inset -0.4rem -0.5rem 0.7rem rgba(20, 0, 40, 0.35);
  }

  .star {
    position: absolute;
    top: 22%;
    left: 16%;
    font-size: 1.1rem;
    color: #ffe56a;
    text-shadow: 0 0 12px #ffe56a;
  }

  .wordmark {
    position: relative;
    margin: 0;
    font-size: clamp(2.4rem, 8vw, 4.2rem);
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1;
    background: linear-gradient(180deg, #fff 0%, #c5c8d4 38%, #fff 52%, #8b90a0 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.35));
  }

  button,
  .enter {
    position: relative;
    display: inline-block;
    margin-top: 0.75rem;
    border: 0;
    border-radius: 9999px;
    padding: 0.45rem 1.15rem;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #041018;
    background: linear-gradient(180deg, #e8fbff 0%, #5ce1ff 45%, #1aa3c7 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.85),
      0 8px 18px rgba(0, 200, 255, 0.25);
  }

  .caption {
    position: absolute;
    bottom: 0.85rem;
    margin: 0;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: lowercase;
    color: rgba(255, 255, 255, 0.62);
  }

  .is-compact .blob {
    width: 3rem;
    height: 3rem;
  }

  .is-compact .wordmark {
    font-size: 2.1rem;
  }

  .is-compact .enter {
    padding: 0.3rem 0.8rem;
    font-size: 0.65rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .blob,
    .star,
    .wordmark {
      filter: none;
      text-shadow: none;
    }
  }
</style>
