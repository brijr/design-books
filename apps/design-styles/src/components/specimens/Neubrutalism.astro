---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class:list={["neubrutalism", compact && "is-compact"]} data-specimen="live">
  <div class="stage">
    <article class="card">
      <header>
        <p class="kicker">Notice</p>
        <p class="title">This is a box.</p>
      </header>
      <p class="body">Hard offset. Thick border. No blur.</p>
      {compact ? <span class="action">Subscribe</span> : <button type="button">Subscribe</button>}
    </article>
  </div>
</div>

<style>
  .neubrutalism {
    height: 100%;
    background: #fff36a;
    color: #111;
  }

  .stage {
    display: grid;
    height: 100%;
    min-height: inherit;
    place-items: center;
    padding: 1.25rem;
  }

  .card {
    display: grid;
    width: min(100%, 18rem);
    gap: 0.7rem;
    border: 3px solid #111;
    background: white;
    padding: 0.9rem 1rem 1rem;
    box-shadow: 6px 6px 0 #111;
  }

  .kicker,
  .body {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .title {
    margin: 0.15rem 0 0;
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .body {
    color: #111;
    text-transform: none;
    letter-spacing: 0;
    font-weight: 500;
  }

  button,
  .action {
    display: inline-block;
    justify-self: start;
    border: 3px solid #111;
    background: #ff4d8d;
    padding: 0.3rem 0.7rem;
    font: inherit;
    font-size: 0.75rem;
    font-weight: 800;
    box-shadow: 3px 3px 0 #111;
  }

  .is-compact .card {
    width: min(100%, 13.5rem);
    gap: 0.45rem;
    padding: 0.65rem 0.75rem 0.75rem;
    box-shadow: 4px 4px 0 #111;
  }

  .is-compact .title {
    font-size: 1.05rem;
  }

  .is-compact .body {
    display: none;
  }
</style>
