---
import { getCollection } from "astro:content";

import StyleRail from "../components/StyleRail.astro";
import Layout from "../layouts/Layout.astro";
import { SITE_DESCRIPTION, SITE_NAME } from "../lib/site";
import { groupByEra, MEDIUMS, mediumLabel, sortByYear } from "../lib/styles";

const entries = sortByYear(await getCollection("styles"));
const eras = groupByEra(entries);
---

<Layout title={SITE_NAME} description={SITE_DESCRIPTION} path="/">
  <section class="catalog grid min-w-0 gap-12">
    <div>
      <h1 class="font-medium">A visual field guide to design.</h1>
      <p class="text-zinc-400">
        Movements and visual languages, arranged in time.
      </p>
    </div>

    <fieldset class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-zinc-400">
      <legend class="sr-only">Filter by medium</legend>
      <label class="cursor-pointer">
        <input class="sr-only" type="radio" name="medium" value="all" checked />
        All
      </label>
      {
        MEDIUMS.map((medium) => (
          <label class="cursor-pointer">
            <input class="sr-only" type="radio" name="medium" value={medium} />
            {mediumLabel(medium)}
          </label>
        ))
      }
    </fieldset>

    <nav aria-label="Jump to a style" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        eras.map((group) => (
          <div class="era-group grid gap-2">
            <p class="font-medium">{group.label}</p>
            <ul class="grid gap-1">
              {group.entries.map((entry) => (
                <li data-medium={entry.data.medium.join(" ")}>
                  <a class="link" href={`#${entry.id}`}>
                    <span class="tabular-nums text-zinc-400">{entry.data.yearStart}</span>
                    {" "}
                    {entry.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>

    {
      entries.map((entry) => (
        <article
          id={entry.id}
          class="grid min-w-0 scroll-mt-6 gap-6"
          data-medium={entry.data.medium.join(" ")}
        >
          <div>
            <p class="tabular-nums text-zinc-400">{entry.data.yearStart}</p>
            <h2 class="font-medium">
              <a class="link" href={`/${entry.id}`}>
                {entry.data.title}
              </a>
            </h2>
            <p class="max-w-prose text-zinc-400">{entry.data.definition}</p>
            <p class="text-sm text-zinc-400">
              {entry.data.type}
              <span aria-hidden="true"> · </span>
              {entry.data.status}
              <span aria-hidden="true"> · </span>
              {entry.data.place}
            </p>
          </div>
          <StyleRail entry={entry} />
        </article>
      ))
    }
  </section>
</Layout>

<style>
  .catalog label:has(:checked) {
    color: var(--color-zinc-950);
  }

  .catalog label:has(:focus-visible) {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .catalog:has([name="medium"][value="graphic"]:checked) [data-medium]:not([data-medium~="graphic"]),
  .catalog:has([name="medium"][value="editorial"]:checked) [data-medium]:not([data-medium~="editorial"]),
  .catalog:has([name="medium"][value="identity"]:checked) [data-medium]:not([data-medium~="identity"]),
  .catalog:has([name="medium"][value="interface"]:checked) [data-medium]:not([data-medium~="interface"]),
  .catalog:has([name="medium"][value="product"]:checked) [data-medium]:not([data-medium~="product"]) {
    display: none;
  }

  .catalog:has([name="medium"][value="graphic"]:checked) .era-group:not(:has([data-medium~="graphic"])),
  .catalog:has([name="medium"][value="editorial"]:checked) .era-group:not(:has([data-medium~="editorial"])),
  .catalog:has([name="medium"][value="identity"]:checked) .era-group:not(:has([data-medium~="identity"])),
  .catalog:has([name="medium"][value="interface"]:checked) .era-group:not(:has([data-medium~="interface"])),
  .catalog:has([name="medium"][value="product"]:checked) .era-group:not(:has([data-medium~="product"])) {
    display: none;
  }
</style>
