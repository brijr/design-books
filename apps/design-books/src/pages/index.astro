---
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";

import Layout from "../layouts/Layout.astro";
import { HomeBookBrowser, type HomeBook, type HomeTopic } from "../components/HomeBookBrowser";
import { getBookTopics } from "../lib/taxonomy";
import { collectionJsonLd, HOME_TITLE, serializeJsonLd, SITE_DESCRIPTION } from "../lib/seo";

const allBooks = await getCollection("books");

// "Recently added" sorts on the authored `addedAt` frontmatter field. It is a
// real value in the file rather than a filesystem timestamp, so the ordering
// survives a fresh CI checkout, where every mtime is the clone time.
const homeBooks: HomeBook[] = await Promise.all(
  allBooks.map(async (book) => {
    const topics = await getBookTopics(book);
    let image: HomeBook["image"] = null;

    if (book.data.cover) {
      const optimized = await getImage({ src: book.data.cover });
      image = {
        src: optimized.src,
        width: book.data.cover.width,
        height: book.data.cover.height,
      };
    }

    return {
      id: book.id,
      slug: book.id,
      title: book.data.title,
      author: book.data.author,
      description: book.data.description,
      link: book.data.link,
      addedAt: book.data.addedAt.toISOString(),
      image,
      topics: topics.map((topic) => ({ slug: topic.id, title: topic.data.title })),
    };
  }),
);

const homeTopicsMap = new Map<string, HomeTopic>();
for (const book of homeBooks) {
  for (const topic of book.topics) {
    homeTopicsMap.set(topic.slug, topic);
  }
}
const homeTopics = [...homeTopicsMap.values()].sort((a, b) =>
  a.title.localeCompare(b.title),
);

const jsonLd = await collectionJsonLd(allBooks);
---

<Layout title={HOME_TITLE} description={SITE_DESCRIPTION} path="/">
  <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />

  <section class="grid gap-12">
    <div>
      <h1 class="font-medium">
        A curated collection of essential books on design.
      </h1>
      <p class="text-zinc-400">
        Product, interaction, visual design, usability, systems, and craft.
      </p>
    </div>

    <HomeBookBrowser client:load books={homeBooks} topics={homeTopics} />
  </section>
</Layout>
